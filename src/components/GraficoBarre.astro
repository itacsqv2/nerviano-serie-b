---
/**
 * Barre verticali generate in build (punti partita per partita, media per stagione).
 * Ogni barra ha un tooltip nativo; le etichette sotto l'asse si diradano se non c'è spazio.
 * Sotto c'è sempre la tabella con gli stessi dati (passata nello slot «dati»).
 */
import { max } from 'd3-array';
import { scaleBand, scaleLinear } from 'd3-scale';
import { f1 } from '../lib/formato.ts';

export interface Barra {
  etichetta: string;
  valore: number;
  classe?: string;
  titolo: string;
  /** testo sopra la barra (etichetta diretta selettiva) */
  sopra?: string;
}
interface Props { id: string; barre: Barra[]; titolo: string; asseY: string; decimali?: boolean }
const { id, barre, titolo, asseY, decimali = false } = Astro.props;
const W = 560, H = 230, M = { t: 18, r: 8, b: 30, l: 34 };
// con poche barre la banda resta stretta (max ~44px) invece di allargarsi su tutto il grafico
const larghezza = Math.min(W - M.l - M.r, Math.max(1, barre.length) * 58);
const x = scaleBand<number>().domain(barre.map((_, i) => i)).range([M.l, M.l + larghezza]).paddingInner(0.25).paddingOuter(0.1);
const y = scaleLinear().domain([0, Math.max(1, max(barre, (b) => b.valore) ?? 1)]).nice(4).range([H - M.b, M.t]);
const passo = Math.max(1, Math.ceil(barre.length / Math.floor((W - M.l - M.r) / 44)));
const fmt = (v: number) => (decimali ? f1(v) : String(v));
// barre con estremità superiore arrotondata (4px) e base piatta sull'asse
const percorso = (x0: number, w: number, y0: number) => {
  const base = H - M.b;
  const r = Math.min(4, w / 2, base - y0);
  if (base - y0 <= 0) return '';
  return `M${x0},${base}V${y0 + r}Q${x0},${y0} ${x0 + r},${y0}H${x0 + w - r}Q${x0 + w},${y0} ${x0 + w},${y0 + r}V${base}Z`;
};
---
<figure class="figura">
  <svg class="grafico" viewBox={`0 0 ${W} ${H}`} role="group" aria-labelledby={id}>
    <title id={id}>{titolo}</title>
    {y.ticks(4).map((t) => (
      <>
        <line class="griglia" x1={M.l} x2={W - M.r} y1={y(t)} y2={y(t)} />
        <text x={M.l - 6} y={y(t) + 4} text-anchor="end">{t}</text>
      </>
    ))}
    <text x="2" y={M.t - 6}>{asseY}</text>
    {barre.map((b, i) => (
      <g>
        <title>{b.titolo}</title>
        <path class:list={['barra', b.classe]} d={percorso(x(i)!, x.bandwidth(), y(b.valore))} />
        {b.valore === 0 && <line class="asse" x1={x(i)!} x2={x(i)! + x.bandwidth()} y1={H - M.b - 1} y2={H - M.b - 1} />}
        {b.sopra && <text class="etichetta-dato" x={x(i)! + x.bandwidth() / 2} y={y(b.valore) - 5} text-anchor="middle">{b.sopra}</text>}
        {i % passo === 0 && <text x={x(i)! + x.bandwidth() / 2} y={H - M.b + 16} text-anchor="middle">{b.etichetta}</text>}
      </g>
    ))}
    <line class="asse" x1={M.l} x2={W - M.r} y1={H - M.b} y2={H - M.b} />
  </svg>
  <slot name="legenda" />
  <details class="dati-grafico">
    <summary>Mostra i dati del grafico</summary>
    <slot name="dati">
      <ul>{barre.map((b) => <li>{b.etichetta}: {fmt(b.valore)}</li>)}</ul>
    </slot>
  </details>
</figure>

<style>
  .figura { margin: 0; }
  .grafico { max-width: 40rem; }
  .grafico text { font-size: 12px; }
</style>
