---
/**
 * Foto del giocatore (solo se presente nel manifest data/manuale/foto.json, §5.1),
 * altrimenti un avatar SVG con iniziali e numero di maglia nei colori della squadra.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import type { Persona } from '../lib/dataset.ts';
import { dati } from '../lib/data.ts';
import { testoSu } from '../lib/colori.ts';

interface Props { persona: Persona; grande?: boolean; credito?: boolean }
const { persona: p, grande = false, credito = false } = Astro.props;
const file = import.meta.glob<{ default: ImageMetadata }>('../assets/giocatori/*.webp', { eager: true });
const foto = p.foto ? file[`../assets/giocatori/${p.foto.file}`]?.default : undefined;
const c = dati().sq(p.squadra).colori;
const iniziali = `${p.nome.charAt(0)}${p.cognome.charAt(0)}`.toUpperCase();
---
{foto && p.foto ? (
  <figure class:list={['avatar', { grande }]}>
    <Picture src={foto} formats={['avif', 'webp']} widths={grande ? [320, 640] : [160, 320]} sizes={grande ? '(min-width: 40rem) 16rem, 60vw' : '5rem'} alt={`Foto di ${p.nomeCompleto}`} loading="lazy" />
    {credito && <figcaption class="nota">{p.foto.credito}</figcaption>}
  </figure>
) : (
  <svg class:list={['avatar', 'svg', { grande }]} viewBox="0 0 80 100" role="img" aria-label={`${p.nomeCompleto}${p.numero ? `, numero ${p.numero}` : ''}: foto non disponibile`}>
    {c ? <rect width="80" height="100" rx="8" fill={c.primario} /> : <rect class="fondo" width="80" height="100" rx="8" />}
    {c ? (
      <text class="iniziali" x="40" y="52" text-anchor="middle" fill={testoSu(c.primario)}>{iniziali}</text>
    ) : (
      <text class="iniziali neutro" x="40" y="52" text-anchor="middle">{iniziali}</text>
    )}
    {p.numero && (c ? (
      <text class="maglia" x="40" y="84" text-anchor="middle" fill={testoSu(c.primario)}>#{p.numero}</text>
    ) : (
      <text class="maglia neutro" x="40" y="84" text-anchor="middle">#{p.numero}</text>
    ))}
  </svg>
)}

<style>
  .avatar { width: 4rem; flex: none; margin: 0; }
  .avatar.grande { width: min(12rem, 45vw); }
  .avatar :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--raggio); }
  .svg { aspect-ratio: 4 / 5; height: auto; }
  .fondo { fill: var(--superficie-2); stroke: var(--bordo); }
  .neutro { fill: var(--inchiostro); }
  text { font-family: var(--font-titoli); font-weight: 700; }
  .iniziali { font-size: 30px; }
  .maglia { font-size: 18px; opacity: 0.85; }
</style>
