---
/**
 * Punti segnati (x) e subiti (y, in alto chi ne subisce meno) a partita per squadra, gare giocate in campo.
 * SVG generato in build con d3-scale; ogni punto è un link alla squadra con tooltip nativo (<title>).
 * Sotto c'è la tabella con gli stessi dati.
 */
import { extent } from 'd3-array';
import { scaleLinear } from 'd3-scale';
import type { RigaClassifica } from '../lib/classifica.ts';
import { dati } from '../lib/data.ts';
import { f1, ordinale } from '../lib/formato.ts';
import { url, urlSquadra } from '../lib/url.ts';

interface Props { righe: RigaClassifica[] }
const d = dati();
const righe = Astro.props.righe.filter((r) => r.pf_media != null && r.ps_media != null);
const W = 480, H = 340, M = { t: 16, r: 16, b: 46, l: 50 };
const dominio = (v: number[]): [number, number] => {
  const [a, b] = extent(v) as [number, number];
  const pad = a === b ? 2 : (b - a) * 0.08;
  return [a - pad, b + pad];
};
const x = scaleLinear().domain(dominio(righe.map((r) => r.pf_media!))).range([M.l, W - M.r]).nice(5);
const y = scaleLinear().domain(dominio(righe.map((r) => r.ps_media!))).range([M.t, H - M.b]).nice(5);

// etichette: Nerviano per prima, poi in ordine di classifica; si prova una posizione libera tra 8
const ordine = [...righe].sort((a, b) => Number(b.squadra === d.rif) - Number(a.squadra === d.rif) || a.posizione - b.posizione);
type Box = { x0: number; y0: number; x1: number; y1: number };
const occupati: Box[] = righe.map((r) => ({ x0: x(r.pf_media!) - 7, y0: y(r.ps_media!) - 7, x1: x(r.pf_media!) + 7, y1: y(r.ps_media!) + 7 }));
const scontra = (b: Box) => occupati.some((o) => b.x0 < o.x1 && b.x1 > o.x0 && b.y0 < o.y1 && b.y1 > o.y0) || b.x0 < M.l || b.x1 > W - M.r || b.y0 < M.t - 4 || b.y1 > H - M.b;
const etichette = new Map<string, { x: number; y: number; anchor: string }>();
for (const r of ordine) {
  const px = x(r.pf_media!), py = y(r.ps_media!);
  const testo = d.sq(r.squadra).breve;
  const w = testo.length * 6.6, h = 13;
  const prove: [number, number, string][] = [[10, 4, 'start'], [-10, 4, 'end'], [0, -11, 'middle'], [0, 19, 'middle'], [8, -8, 'start'], [-8, -8, 'end'], [8, 15, 'start'], [-8, 15, 'end']];
  const box = ([dx, dy, anchor]: [number, number, string]): Box => {
    const x0 = anchor === 'start' ? px + dx : anchor === 'end' ? px + dx - w : px - w / 2;
    return { x0, y0: py + dy - h + 2, x1: x0 + w, y1: py + dy + 2 };
  };
  // la prima posizione libera; per Nerviano l'etichetta c'è sempre (al limite sovrapposta)
  const scelta = prove.find((p) => !scontra(box(p))) ?? (r.squadra === d.rif ? prove[0] : undefined);
  if (scelta) {
    etichette.set(r.squadra, { x: px + scelta[0], y: py + scelta[1], anchor: scelta[2] });
    occupati.push(box(scelta));
  }
}
const tick = (n: number) => f1(n).replace(',0', '');
const href = (s: string) => (s === d.rif ? url('/nerviano/') : urlSquadra(s));
---
<figure class="figura">
  <svg class="grafico" viewBox={`0 0 ${W} ${H}`} role="group" aria-labelledby="ad-titolo">
    <title id="ad-titolo">Punti segnati e subiti a partita per squadra</title>
    {x.ticks(5).map((t) => <line class="griglia" x1={x(t)} x2={x(t)} y1={M.t} y2={H - M.b} />)}
    {y.ticks(5).map((t) => <line class="griglia" x1={M.l} x2={W - M.r} y1={y(t)} y2={y(t)} />)}
    <line class="asse" x1={M.l} x2={W - M.r} y1={H - M.b} y2={H - M.b} />
    <line class="asse" x1={M.l} x2={M.l} y1={M.t} y2={H - M.b} />
    {x.ticks(5).map((t) => <text x={x(t)} y={H - M.b + 16} text-anchor="middle">{tick(t)}</text>)}
    {y.ticks(5).map((t) => <text x={M.l - 6} y={y(t) + 4} text-anchor="end">{tick(t)}</text>)}
    <text x={(M.l + W - M.r) / 2} y={H - 6} text-anchor="middle">Punti segnati a partita →</text>
    <text transform={`translate(13 ${(M.t + H - M.b) / 2}) rotate(-90)`} text-anchor="middle">Punti subiti (in alto meno) →</text>
    {[...righe].sort((a, b) => Number(a.squadra === d.rif) - Number(b.squadra === d.rif)).map((r) => {
      const noi = r.squadra === d.rif;
      const e = etichette.get(r.squadra);
      const s = d.sq(r.squadra);
      return (
        <a href={href(r.squadra)}>
          <title>{`${s.breve}: ${f1(r.pf_media)} punti segnati e ${f1(r.ps_media)} subiti a partita\n${ordinale(r.posizione)} in classifica, vinte ${r.v} e perse ${r.p}`}</title>
          <circle class:list={['punto', { noi }]} cx={x(r.pf_media!)} cy={y(r.ps_media!)} r={noi ? 8 : 5.5} />
          {e && <text class:list={{ 'etichetta-dato': noi }} x={e.x} y={e.y} text-anchor={e.anchor}>{s.breve}</text>}
        </a>
      );
    })}
  </svg>
  <figcaption class="nota">In alto a destra chi segna tanto e subisce poco; in basso a sinistra il contrario. Nerviano è il punto arancione.</figcaption>
  <details class="dati-grafico">
    <summary>Mostra i dati del grafico</summary>
    <div class="tabella-scorre">
      <table data-ordinabile>
        <caption class="sr-only">Punti segnati e subiti a partita per squadra</caption>
        <thead><tr><th scope="col" data-tipo="testo">Squadra</th><th scope="col" class="num" data-tipo="num">Segnati</th><th scope="col" class="num" data-tipo="num">Subiti</th></tr></thead>
        <tbody>
          {righe.map((r) => <tr class:list={{ noi: r.squadra === d.rif }}><th scope="row">{d.sq(r.squadra).breve}</th><td class="num" data-valore={r.pf_media}>{f1(r.pf_media)}</td><td class="num" data-valore={r.ps_media}>{f1(r.ps_media)}</td></tr>)}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .figura { margin: 0; }
  .grafico { max-width: 44rem; }
  .grafico text { font-size: 12.5px; }
</style>
